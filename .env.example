# Copier ce fichier en .env.local et renseigner les valeurs (ne jamais committer .env.local).

# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domaine email autorisé à se connecter (ex. entreprise.com), vide = tous
ALLOWED_EMAIL_DOMAIN=

# Export quotidien vers le Google Sheet miroir
EXPORT_SPREADSHEET_ID=
EXPORT_SHEET_TAB=Export CRM
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Secret de la tâche planifiée Vercel
CRON_SECRET=
