# Copier ce fichier en .env.local et renseigner les valeurs (ne jamais committer .env.local).

# Supabase : Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Domaine email autorisé à se connecter (ex. entreprise.com), vide = tous
ALLOWED_EMAIL_DOMAIN=

# Export quotidien vers le Google Sheet miroir
EXPORT_SPREADSHEET_ID=
EXPORT_SHEET_TAB=Export CRM
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_KEY=

# Secret de la tâche planifiée Vercel
CRON_SECRET=

# Emails des rendez-vous : renseigner UNE des deux options.
# Option 1 : Resend (resend.com), avec un domaine d'envoi validé
RESEND_API_KEY=
# Option 2 : un compte email en SMTP, par ex. Gmail avec un mot de passe d'application
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Expéditeur affiché, ex. « Cerise <cerise@entreprise.com> » (par défaut : SMTP_USER)
EMAIL_FROM=
# Adresse de l'application, pour les liens dans les emails
NEXT_PUBLIC_SITE_URL=https://crm-forecast-susu-73c6.vercel.app
